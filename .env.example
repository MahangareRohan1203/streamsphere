# Database Credentials
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=streamsphere_video

# Kafka Configuration
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092

# MinIO Credentials
